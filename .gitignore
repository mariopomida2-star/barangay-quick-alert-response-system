const toast = document.querySelector('#toast');
const buttons = document.querySelectorAll('[data-form]');

const formMessages = {
  'submit-new-report': 'Submit New Report form will be connected here later.',
  'view-all-reports': 'View All Reports form view will be connected here later.',
  'my-submission': 'My Submission form will be connected here later.',
  'how-to-use': 'How to Use guide page will be connected here later.',
  exit: 'Exit action will close or redirect later.',
  login: 'Log In screen will be connected here later.'
};

const showToast = (key) => {
  if (!toast) return;

  toast.textContent = formMessages[key] || 'Form page is ready to be connected later.';
  toast.classList.add('visible');

  window.clearTimeout(showToast.timeoutId);
  showToast.timeoutId = window.setTimeout(() => {
    toast.classList.remove('visible');
  }, 2200);
};

buttons.forEach((button) => {
  button.addEventListener('click', () => {
    const formKey = button.dataset.form;
    showToast(formKey);
  });
});

window.addEventListener('load', () => {
  document.body.classList.add('ready');
});
